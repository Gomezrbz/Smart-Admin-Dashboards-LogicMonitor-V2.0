    {
      "position": {
        "col": 1,
        "sizex": 12,
        "row": 4,
        "sizey": 5
      },
      "config": {
        "displaySettings": {},
        "isSupportCustomProperty": false,
        "supportCustomProperty": false,
        "name": "Adoption and Optimization \u2014 Read First",
        "description": "Read first guide for this dashboard.",
        "theme": "newSolidDarkBlue",
        "interval": 15,
        "type": "text",
        "timescale": "day",
        "version": 2,
        "content": "<div style=\"font-family:Arial,Helvetica,sans-serif;line-height:1.45;background:#0f172a;color:#e5e7eb;border:1px solid #1f2937;border-radius:14px;padding:16px;width:100%;box-sizing:border-box;\">\n<div style=\"font-size:18px;font-weight:700;color:#f9fafb;margin-bottom:4px;\">Adoption and Optimization</div>\n<div style=\"font-size:13px;color:#9ca3af;margin-bottom:12px;\">Packages hygiene metrics as continuous improvement and platform value for CS and leadership.</div>\n<table style=\"width:100%;border-collapse:separate;border-spacing:10px;\"><tr>\n<td style=\"vertical-align:top;background:#020617;border:1px solid #1f2937;border-radius:12px;padding:12px;width:33%;\">\n<div style=\"font-size:13px;font-weight:700;margin-bottom:8px;\">Questions this dashboard answers</div>\n<ul style=\"margin:0;padding-left:18px;font-size:12px;\"><li style=\"margin:5px 0;\">Is alert noise declining?</li><li style=\"margin:5px 0;\">Are idle identities cleaned up?</li><li style=\"margin:5px 0;\">Are coverage gaps closing?</li><li style=\"margin:5px 0;\">Are integrations healthy?</li></ul>\n</td>\n<td style=\"vertical-align:top;background:#020617;border:1px solid #1f2937;border-radius:12px;padding:12px;width:34%;\">\n<div style=\"font-size:13px;font-weight:700;margin-bottom:8px;\">Recommended review flow</div>\n<ol style=\"margin:0;padding-left:18px;font-size:12px;\"><li style=\"margin:5px 0;\"><strong>Alert trend + top datasources</strong> \u2014 Noise</li><li style=\"margin:5px 0;\"><strong>Idle access KPIs</strong> \u2014 Identity hygiene</li><li style=\"margin:5px 0;\"><strong>Coverage gap trends</strong> \u2014 Blind spots</li><li style=\"margin:5px 0;\"><strong>Integration failures</strong> \u2014 Routing health</li></ol>\n</td>\n<td style=\"vertical-align:top;background:#020617;border:1px solid #1f2937;border-radius:12px;padding:12px;width:33%;\">\n<div style=\"font-size:13px;font-weight:700;margin-bottom:8px;\">Where to go next</div>\n<ul style=\"margin:0;padding-left:18px;font-size:12px;\"><li style=\"margin:5px 0;\">Platform Value \u2014 01 \u2014 close the loop</li><li style=\"margin:5px 0;\">Alert Overview \u2014 03</li><li style=\"margin:5px 0;\">Access \u2014 06</li><li style=\"margin:5px 0;\">Coverage \u2014 04</li></ul>\n<div style=\"margin-top:10px;font-size:11px;color:#94a3b8;\">Empty / zero: confirm tokens and LogicModules. Healthy zero critical alerts still warrants Warning and dead-resource checks.</div>\n</td>\n</tr></table>\n</div>"
      }
    },
