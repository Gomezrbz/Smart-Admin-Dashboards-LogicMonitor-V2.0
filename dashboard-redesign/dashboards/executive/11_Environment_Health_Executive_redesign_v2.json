      "config": {
        "displaySettings": {},
        "isSupportCustomProperty": false,
        "supportCustomProperty": false,
        "name": "Environment Health Executive \u2014 Read First",
        "description": "Read first guide for this dashboard.",
        "theme": "newSolidDarkBlue",
        "interval": 15,
        "type": "text",
        "timescale": "day",
        "version": 2,
        "content": "<div style=\"font-family:Arial,Helvetica,sans-serif;line-height:1.45;background:#0f172a;color:#e5e7eb;border:1px solid #1f2937;border-radius:14px;padding:18px;width:100%;box-sizing:border-box;\">\n<div style=\"margin-bottom:16px;\">\n<div style=\"font-size:20px;font-weight:700;color:#f9fafb;\">Environment Health Executive Overview</div>\n<div style=\"font-size:13px;color:#9ca3af;margin-top:4px;\">Leadership-density view of where risk is concentrated \u2014 without deep operational tables.</div>\n</div>\n<table style=\"width:100%;border-collapse:separate;border-spacing:16px;\"><tr>\n<td style=\"vertical-align:top;background:#020617;border:1px solid #1f2937;border-radius:12px;padding:14px;width:33%;\">\n<div style=\"font-size:15px;font-weight:700;margin-bottom:10px;color:#f9fafb;\">Questions this dashboard answers</div>\n<ul style=\"margin:0;padding-left:18px;font-size:12px;color:#e5e7eb;\"><li style=\"margin:5px 0;\">Where is risk concentrated geographically or by type?</li><li style=\"margin:5px 0;\">Are dead or minimally monitored resources rising?</li><li style=\"margin:5px 0;\">Are collectors and websites signaling trouble?</li></ul>\n</td>\n<td style=\"vertical-align:top;background:#020617;border:1px solid #1f2937;border-radius:12px;padding:14px;width:34%;\">\n<div style=\"font-size:15px;font-weight:700;margin-bottom:10px;color:#f9fafb;\">Recommended review flow</div>\n<ol style=\"margin:0;padding-left:18px;font-size:12px;color:#e5e7eb;\"><li style=\"margin:5px 0;\"><strong>Map + NOC</strong> \u2014 Concentration</li><li style=\"margin:5px 0;\"><strong>Dead / minimal / websites</strong> \u2014 Blind spots</li><li style=\"margin:5px 0;\"><strong>Collector pulse</strong> \u2014 Trust in data</li><li style=\"margin:5px 0;\"><strong>Drill to Ops</strong> \u2014 Resource Health / Alerts</li></ol>\n</td>\n<td style=\"vertical-align:top;background:#020617;border:1px solid #1f2937;border-radius:12px;padding:14px;width:33%;\">\n<div style=\"font-size:15px;font-weight:700;margin-bottom:10px;color:#f9fafb;\">Where to go next</div>\n<ul style=\"margin:0;padding-left:18px;font-size:12px;color:#e5e7eb;\"><li style=\"margin:5px 0;\">Operational Resource Health \u2192 02</li><li style=\"margin:5px 0;\">Active Alerts \u2192 03</li><li style=\"margin:5px 0;\">Collector Diagnostics \u2192 07</li><li style=\"margin:5px 0;\">Websites \u2192 05 / 12</li></ul>\n<div style=\"margin-top:14px;font-size:12px;color:#9ca3af;\">Tip: Empty or zero values may mean healthy state or missing tokens/LogicModules \u2014 confirm before concluding.</div>\n</td>\n</tr></table>\n</div>"
      }
    },
