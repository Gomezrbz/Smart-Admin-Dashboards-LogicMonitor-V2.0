      "config": {
        "displaySettings": {},
        "isSupportCustomProperty": false,
        "supportCustomProperty": false,
        "name": "Operational Command Center \u2014 Read First",
        "description": "DCC-style executive guide.",
        "theme": "newSolidDarkBlue",
        "interval": 15,
        "type": "text",
        "timescale": "day",
        "version": 2,
        "content": "<div style=\"font-family:Arial,Helvetica,sans-serif;background:linear-gradient(135deg,#0f172a 0%,#111827 45%,#1e3a8a 100%);color:#ffffff;border-radius:16px;padding:22px;box-shadow:0 8px 24px rgba(15,23,42,.32);width:100%;box-sizing:border-box;\">\n<div style=\"font-size:28px;font-weight:750;color:#ffffff;margin-bottom:6px;\">Operational Command Center</div>\n<div style=\"font-size:13px;color:#dbeafe;margin-bottom:16px;max-width:960px;\">Daily triage hub: prioritize alerts, unhealthy resources, collector pulse, then drill.</div>\n<table style=\"width:100%;border-collapse:separate;border-spacing:14px;\"><tr><td style=\"vertical-align:top;background:rgba(15,23,42,.76);border:1px solid rgba(148,163,184,.34);border-radius:14px;padding:16px;min-height:150px;width:16%;\"><div style=\"display:inline-block;width:auto;padding:6px 10px;border-radius:11px;background:rgba(59,130,246,.22);border:1px solid rgba(255,255,255,.18);font-size:11px;font-weight:800;color:#dbeafe;\">ALERT</div><div style=\"font-size:15px;font-weight:700;color:#ffffff;margin:10px 0 6px;\">Triage severity</div><div style=\"font-size:13px;line-height:1.48;color:#cbd5e1;\">Start with Critical and Error counts, then live lists.</div><span style=\"display:inline-block;margin-top:12px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:#bfdbfe;font-size:12px;font-weight:700;\">Active Alerts</span></td><td style=\"vertical-align:top;background:rgba(15,23,42,.76);border:1px solid rgba(148,163,184,.34);border-radius:14px;padding:16px;min-height:150px;width:16%;\"><div style=\"display:inline-block;width:auto;padding:6px 10px;border-radius:11px;background:rgba(59,130,246,.22);border:1px solid rgba(255,255,255,.18);font-size:11px;font-weight:800;color:#dbeafe;\">RES</div><div style=\"font-size:15px;font-weight:700;color:#ffffff;margin:10px 0 6px;\">Resource health</div><div style=\"font-size:13px;line-height:1.48;color:#cbd5e1;\">Dead, minimal, SDT, and map concentration.</div><span style=\"display:inline-block;margin-top:12px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:#bfdbfe;font-size:12px;font-weight:700;\">Resource Health</span></td><td style=\"vertical-align:top;background:rgba(15,23,42,.76);border:1px solid rgba(148,163,184,.34);border-radius:14px;padding:16px;min-height:150px;width:16%;\"><div style=\"display:inline-block;width:auto;padding:6px 10px;border-radius:11px;background:rgba(59,130,246,.22);border:1px solid rgba(255,255,255,.18);font-size:11px;font-weight:800;color:#dbeafe;\">COL</div><div style=\"font-size:15px;font-weight:700;color:#ffffff;margin:10px 0 6px;\">Collector pulse</div><div style=\"font-size:13px;line-height:1.48;color:#cbd5e1;\">Confirm collection before trusting gaps.</div><span style=\"display:inline-block;margin-top:12px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:#bfdbfe;font-size:12px;font-weight:700;\">Alive / down</span></td><td style=\"vertical-align:top;background:rgba(15,23,42,.76);border:1px solid rgba(148,163,184,.34);border-radius:14px;padding:16px;min-height:150px;width:16%;\"><div style=\"display:inline-block;width:auto;padding:6px 10px;border-radius:11px;background:rgba(59,130,246,.22);border:1px solid rgba(255,255,255,.18);font-size:11px;font-weight:800;color:#dbeafe;\">WEB</div><div style=\"font-size:15px;font-weight:700;color:#ffffff;margin:10px 0 6px;\">Services</div><div style=\"font-size:13px;line-height:1.48;color:#cbd5e1;\">Dead websites and empty groups.</div><span style=\"display:inline-block;margin-top:12px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:#bfdbfe;font-size:12px;font-weight:700;\">Websites</span></td></tr><tr><td style=\"vertical-align:top;background:rgba(15,23,42,.76);border:1px solid rgba(148,163,184,.34);border-radius:14px;padding:16px;min-height:150px;width:16%;\"><div style=\"display:inline-block;width:auto;padding:6px 10px;border-radius:11px;background:rgba(59,130,246,.22);border:1px solid rgba(255,255,255,.18);font-size:11px;font-weight:800;color:#dbeafe;\">NEXT</div><div style=\"font-size:15px;font-weight:700;color:#ffffff;margin:10px 0 6px;\">Investigate</div><div style=\"font-size:13px;line-height:1.48;color:#cbd5e1;\">Open Technical Investigation when root cause needed.</div><span style=\"display:inline-block;margin-top:12px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:#bfdbfe;font-size:12px;font-weight:700;\">Tech hub</span></td><td style=\"vertical-align:top;background:rgba(15,23,42,.76);border:1px solid rgba(148,163,184,.34);border-radius:14px;padding:16px;min-height:150px;width:16%;\"><div style=\"display:inline-block;width:auto;padding:6px 10px;border-radius:11px;background:rgba(59,130,246,.22);border:1px solid rgba(255,255,255,.18);font-size:11px;font-weight:800;color:#dbeafe;\">BACK</div><div style=\"font-size:15px;font-weight:700;color:#ffffff;margin:10px 0 6px;\">Exec summary</div><div style=\"font-size:13px;line-height:1.48;color:#cbd5e1;\">Return leaders to Command Center when stabilized.</div><span style=\"display:inline-block;margin-top:12px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:#bfdbfe;font-size:12px;font-weight:700;\">Exec CC</span></td></tr></table>\n</div>"
      }
