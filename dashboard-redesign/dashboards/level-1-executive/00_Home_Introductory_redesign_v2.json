        "name": "Welcome",
        "description": "Platform value statement and package orientation.",
        "theme": "newSolidDarkBlue",
        "interval": 15,
        "type": "text",
        "timescale": "day",
        "version": 2,
        "content": "<div style=\"font-family:Arial,Helvetica,sans-serif;background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#e5e7eb;border-radius:14px;padding:18px;\">\n<div style=\"font-size:22px;font-weight:700;color:#f8fafc;\">SmartAdmin Connected Experience</div>\n<div style=\"font-size:13px;color:#cbd5e1;margin-top:6px;max-width:900px;\">Portal administration and platform-value dashboards for client reviews. Start from this Home page, then drill into operational and technical views. Use dashboard tokens to reuse the package across environments.</div>\n</div>"
      }
    },
    {
      "position": {
